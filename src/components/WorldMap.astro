---
// The map of reports: MapLibre GL JS on OpenFreeMap's vector tiles (src/lib/map.js), dark or light
// with the site's theme, a diamond marker per report by type; grouping crowded markers into numbered
// clusters is an option in the Layers panel (off unless the reader turns it on). The markers come from the shared index (/api/index.json), loaded once and cached by the
// browser, so a page does not carry the reports itself however many there are.
//   focus: a report to centre on and ring (the report page): a shaded circle around it as large as
//   its location is uncertain, every Landrace layer on but faded to 30%, as are the other reports;
//   no layer switch, no globe and no hover boxes
//   (the home page takes ?focus=<id> too: it jumps to that report and rings it)
//   country: show its reports (states included), with the whole country framed before first paint
//   hash: keep the view in the address (#map=zoom/lat/lon), so a view can be shared (the Map page)
//   otherwise all reports and the whole world; the home page's filters narrow it through the
//   "reports:filter" event, and pointing at a report in its list rings it ("reports:hover").
// Optional layers show Landrace.wiki's growing areas (their outlines), growing regions and accessions
// (CC BY-SA 4.0, snapshots in public/layers/, each loaded only when its layer is switched on): where
// cannabis has been grown for generations, next to where it is destroyed.
import { MAP_STYLES } from "../lib/map.js";
import { countryOf } from "../lib/countries.js";
import { countryMask } from "../lib/country-mask.js";
import { TYPES, typeIcon } from "../lib/types.js";
const { focus = null, country = null, hash = false, label = "Map of reports" } = Astro.props;
const countryBounds = country && !country.includes("/") ? countryMask(countryOf(country)?.iso_numeric)?.properties.bbox : null;
const ZOOM = { exact: 9, locality: 8, district: 7, region: 5, country: 4 };
const view = focus?.coordinates ? { center: [focus.coordinates[1], focus.coordinates[0]], zoom: ZOOM[focus.precision] ?? 5 } : null;
// how far from the dot it may have happened, by how precisely the sources name the place (km); a
// report known only by its country gets no circle
const RADIUS = { exact: 0.5, locality: 4, district: 25, region: 120 };
const accuracy = focus?.coordinates && RADIUS[focus.precision] ? { center: [focus.coordinates[1], focus.coordinates[0]], km: RADIUS[focus.precision] } : null;
// accessions by seed lot status, with Landrace.wiki's own colours (MediaWiki:Common.js); no seed lot is a hollow dot
const LOTS = [["Urgent", "#c92a2a"], ["At risk", "#e67700"], ["Secure", "#0ca678"], ["Held in a genebank", "#4c6ef5"], ["No data yet", "#6c757d"], ["No seed lot recorded", null]];
const types = Object.fromEntries(Object.entries(TYPES).map(([k, v]) => [k, { label: v.label, color: v.color, icon: typeIcon(k, 64) }]));
---
<div class="map" data-map data-styles={JSON.stringify(MAP_STYLES)} data-base={import.meta.env.BASE_URL}
  data-loading aria-busy="true" data-country-bounds={countryBounds ? JSON.stringify(countryBounds) : undefined} data-view={view ? JSON.stringify(view) : undefined} data-focus={focus?.id} data-country={country ?? undefined} data-hash={hash ? "" : undefined}
  data-accuracy={accuracy ? JSON.stringify(accuracy) : undefined} data-types={JSON.stringify(types)} role="region" aria-label={label}>
  <div class="map-loading" role="status" aria-live="polite">
    <div class="map-loader-plot" aria-hidden="true">
      <svg viewBox="0 0 180 100" fill="none">
        <path class="map-loader-contour" d="M12 38 30 22 55 28 73 13 96 25 116 17 143 31 166 25M8 60 31 47 52 54 78 39 101 49 121 40 147 53 172 45M16 83 37 69 61 76 84 61 109 72 130 61 156 77 174 66" />
        <path class="map-loader-route" d="M32 56 70 34 111 64 150 39" />
        <g class="map-loader-pin" style="--pin:0"><path d="m32 49 7 7-7 7-7-7Z" /><circle cx="32" cy="56" r="1.5" /></g>
        <g class="map-loader-pin" style="--pin:1"><path d="m70 27 7 7-7 7-7-7Z" /><circle cx="70" cy="34" r="1.5" /></g>
        <g class="map-loader-pin" style="--pin:2"><path d="m111 57 7 7-7 7-7-7Z" /><circle cx="111" cy="64" r="1.5" /></g>
        <g class="map-loader-pin" style="--pin:3"><path d="m150 32 7 7-7 7-7-7Z" /><circle cx="150" cy="39" r="1.5" /></g>
      </svg>
    </div>
    <span class="map-loading-label">Preparing your map</span>
  </div>
  {!focus && <details class="map-layers">
    <summary>Layers</summary>
    <label><input type="checkbox" data-option="cluster" /> <span class="swatch cluster">3</span> Group nearby reports</label>
    <label><input type="checkbox" data-layer="area" /> <span class="swatch area"></span> Landrace growing areas</label>
    <label><input type="checkbox" data-layer="region" /> <span class="swatch region"></span> Landrace growing regions</label>
    <label><input type="checkbox" data-layer="accession" /> <span class="swatch accession"></span> Landrace accessions</label>
    <ul class="lot-key" aria-label="Accessions by seed lot status">
      {LOTS.map(([label, color]) => <li><span class="lot-dot" style={color ? `background:${color}` : undefined}></span>{label}</li>)}
    </ul>
    <p>From <a href="https://landrace.wiki/" target="_blank" rel="noopener">Landrace.wiki</a>, CC BY-SA 4.0. Places offset by about 500 m.</p>
  </details>}
</div>

<script>
  import * as maplibregl from "maplibre-gl";
  import "../scripts/maplibre-worker.js";
  import "maplibre-gl/dist/maplibre-gl.css";
  import { pointBounds } from "../lib/map-view.js";
  import { loadIndex, inCountry, type Row } from "../scripts/report-index";

  const esc = (s = "") => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const fmtDate = (d: string) => new Date(`${d}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
  const theme = () => (document.documentElement.dataset.theme === "light" ? "light" : "dark");
  // the colours drawn on top of the basemap, per theme
  const INK = {
    dark: { ink: "#f2f0e9", bg: "#0c0c0b", green: "#5fbf7f", greenFill: "#3f9a5f", greenText: "#7fcf98" },
    light: { ink: "#11110f", bg: "#f4f2eb", green: "#2e8a4f", greenFill: "#3f9a5f", greenText: "#23703f" },
  };

  for (const box of document.querySelectorAll<HTMLElement>("[data-map]")) {
    const { base = "/", country } = box.dataset;
    // the report this map is about (the report page), or the one the home page was asked to show
    const focus = box.dataset.focus ?? (box.dataset.hash != null ? new URLSearchParams(location.search).get("focus") ?? undefined : undefined);
    const single = box.dataset.focus != null; // a report page's map: everything else faded, no switches
    const FADE = single ? 0.3 : 1;
    const markerScale = 0.85; // all point indicators on big maps and report minimaps
    const accuracy = box.dataset.accuracy ? JSON.parse(box.dataset.accuracy) : null;
    const types = JSON.parse(box.dataset.types!);
    const styles = JSON.parse(box.dataset.styles!);
    const countryBounds: number[] | null = box.dataset.countryBounds ? JSON.parse(box.dataset.countryBounds) : null;
    const view = box.dataset.view ? JSON.parse(box.dataset.view)
      : countryBounds ? { bounds: [[countryBounds[0], countryBounds[1]], [countryBounds[2], countryBounds[3]]], fitBoundsOptions: { padding: 30, maxZoom: 9 } }
      : { bounds: [[-168, -50], [178, 72]] };
    const map = new maplibregl.Map({
      container: box, style: styles[theme()], ...view,
      // Report pins near ±180° need wrapping; otherwise the camera is clamped
      // inward by half the viewport width and the report pin appears off-centre.
      minZoom: -1, maxZoom: 14, fadeDuration: 0, renderWorldCopies: single || !!country || !!focus, hash: box.dataset.hash != null ? "map" : false,
      // on a phone, or a small map inside a page, one finger or the wheel scrolls the page
      cooperativeGestures: box.dataset.view != null || matchMedia("(pointer: coarse)").matches,
      attributionControl: { compact: true, customAttribution: '<a href="https://landrace.wiki/" target="_blank" rel="noopener">Landrace.wiki</a> (CC BY-SA)' },
    });
    const ready = () => {
      if (!box.hasAttribute("data-loading")) return;
      delete box.dataset.loading;
      const loader = box.querySelector(".map-loading");
      const finish = () => { loader?.remove(); box.setAttribute("aria-busy", "false"); };
      if (!loader || matchMedia("(prefers-reduced-motion: reduce)").matches) { finish(); return; }
      loader.classList.add("map-loading-ready");
      loader.addEventListener("transitionend", event => { if (event.target === loader) finish(); }, { once: true });
      setTimeout(finish, 200);
    };
    const slow = setTimeout(() => {
      const label = box.querySelector(".map-loading-label");
      if (label) label.textContent = "Map is taking longer to load…";
    }, 15000);
    const reveal = () => { clearTimeout(slow); ready(); };
    // zoom, the compass (it turns as the map is rotated with the right button; a click turns it back
    // to north and flat) and the switch between the flat map and the globe
    map.addControl(new maplibregl.NavigationControl({ showCompass: true, visualizePitch: true }), "top-right");
    if (box.dataset.focus == null) map.addControl(new maplibregl.GlobeControl(), "top-right"); // not on a report page's small map

    let index: Awaited<ReturnType<typeof loadIndex>>;
    let rows: Row[] = [];        // this map's reports
    let shown: Row[] = [];       // those the filters let through
    let hovered = "";
    const KEY = "map-layers-v2";    // which Landrace layers are on, remembered in this browser
    let chosen: Record<string, boolean> = { cluster: false, globe: false, area: true, region: true, accession: true };
    // the Landrace files each layer needs, and the map layers it draws
    const FILES: Record<string, string> = { points: "landrace.geojson", areas: "landrace-areas.geojson", regions: "landrace-regions.geojson" };
    const NEEDS: Record<string, string[]> = { area: ["points", "areas"], region: ["regions"], accession: ["points"] };
    const LAYERS: Record<string, string[]> = {
      area: ["landrace-area-fill", "landrace-area-line", "landrace-area-dot", "landrace-area-label"],
      region: ["landrace-region-fill", "landrace-region-line"],
      accession: ["landrace-accession"],
    };
    const loaded: Record<string, unknown> = {};
    if (single) chosen = { ...chosen, area: true, region: true, accession: true };
    else try {
      const saved = localStorage.getItem(KEY);
      if (saved) chosen = { ...chosen, ...JSON.parse(saved) };
      else {
        // Apply the new Landrace defaults once, retaining the other map preferences.
        const previous = JSON.parse(localStorage.getItem("map-layers") ?? "{}");
        chosen.cluster = previous.cluster ?? chosen.cluster;
        chosen.globe = previous.globe ?? chosen.globe;
      }
    } catch {}

    if (country) chosen.globe = false; // country framing is flat, independent of the world-map preference

    // Fetch the initial overlays together while the basemap loads, so the loader
    // reveals the complete map rather than letting extra layers pop in later.
    const initialFiles = new Set(Object.keys(NEEDS).filter(kind => chosen[kind]).flatMap(kind => NEEDS[kind]));
    const initialLayers = Promise.allSettled([...initialFiles].map(async key => {
      const response = await fetch(`${base}layers/${FILES[key]}`, { signal: AbortSignal.timeout(15000) });
      if (response.ok) loaded[key] = await response.json();
    }));

    const geojson = (list: Row[]) => ({
      type: "FeatureCollection" as const,
      features: list.filter((r) => r.ll).map((r) => ({
        type: "Feature" as const,
        geometry: { type: "Point" as const, coordinates: r.ll! },
        properties: { id: r.i, t: r.t, title: r.ti, type: types[r.t].label, color: types[r.t].color, date: fmtDate(r.d), place: [r.p, index.countries[r.c]].filter(Boolean).join(" · "), focus: r.i === focus },
      })),
    });

    // the type markers, from the same SVG as the legend
    const icons = () => Promise.all(Object.entries(types).map(async ([k, v]: [string, any]) => {
      if (map.hasImage(`t-${k}`)) return;
      const img = new Image(64, 64);
      img.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(v.icon)}`;
      await img.decode();
      map.addImage(`t-${k}`, img, { pixelRatio: 2 });
    }));

    // the Landrace layers, under the reports, for whatever data has been loaded
    function addLandrace() {
      const c = INK[theme()];
      for (const [key, data] of Object.entries(loaded)) if (!map.getSource(`lr-${key}`)) map.addSource(`lr-${key}`, { type: "geojson", data: data as any });
      const vis = (kind: string) => ({ visibility: chosen[kind] ? "visible" : "none" } as const);
      const defs: any[] = [
        { id: "landrace-region-fill", kind: "region", type: "fill", source: "lr-regions", paint: { "fill-color": c.greenFill, "fill-opacity": 0.05 * FADE } },
        { id: "landrace-region-line", kind: "region", type: "line", source: "lr-regions", paint: { "line-color": c.green, "line-width": 1, "line-opacity": 0.75 * FADE, "line-dasharray": [3, 2] } },
        { id: "landrace-area-fill", kind: "area", type: "fill", source: "lr-areas", paint: { "fill-color": c.greenFill, "fill-opacity": 0.2 * FADE } },
        { id: "landrace-area-line", kind: "area", type: "line", source: "lr-areas", paint: { "line-color": c.green, "line-width": ["interpolate", ["linear"], ["zoom"], 2, 0.6, 8, 1.4], "line-opacity": 0.9 * FADE } },
        // a growing area without an outline is a circle
        {
          id: "landrace-area-dot", kind: "area", type: "circle", source: "lr-points", filter: ["all", ["==", ["get", "kind"], "area"], ["!", ["get", "outlined"]]],
          paint: { "circle-radius": ["interpolate", ["linear"], ["zoom"], 1, 5 * markerScale, 6, 14 * markerScale, 10, 34 * markerScale], "circle-color": c.greenFill, "circle-opacity": 0.22 * FADE, "circle-stroke-color": c.green, "circle-stroke-width": 1, "circle-stroke-opacity": 0.8 * FADE },
        },
        {
          id: "landrace-area-label", kind: "area", type: "symbol", source: "lr-points", filter: ["==", ["get", "kind"], "area"], minzoom: 4.5,
          layout: { "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 11, "text-optional": true },
          paint: { "text-color": c.greenText, "text-halo-color": c.bg, "text-halo-width": 1.2, "text-opacity": FADE },
        },
        {
          // filled in its seed lot's colour (Landrace.wiki's), hollow when no seed lot is recorded
          id: "landrace-accession", kind: "accession", type: "circle", source: "lr-points", filter: ["==", ["get", "kind"], "accession"],
          paint: {
            "circle-radius": ["interpolate", ["linear"], ["zoom"], 1, 2.6 * markerScale, 8, 5.5 * markerScale],
            "circle-color": ["match", ["coalesce", ["get", "lot"], ""], "Urgent", "#c92a2a", "At risk", "#e67700", "Secure", "#0ca678", "Held in a genebank", "#4c6ef5", "Data deficient", "#6c757d", c.bg],
            "circle-stroke-color": c.ink, "circle-stroke-width": ["case", ["!=", ["coalesce", ["get", "lot"], ""], ""], 0.8 * markerScale, 1.4 * markerScale], "circle-stroke-opacity": 0.85 * FADE, "circle-opacity": FADE,
          },
        },
      ];
      // always in this order, bottom to top, whichever file arrived first: each goes under the next
      // one already on the map, or under the reports
      defs.forEach(({ kind, ...def }, i) => {
        if (map.getLayer(def.id) || !map.getSource(def.source)) return;
        const above = defs.slice(i + 1).find((d) => map.getLayer(d.id))?.id ?? "clusters";
        map.addLayer({ ...def, layout: { ...(def.layout ?? {}), ...vis(kind) } }, above);
      });
    }

    // everything drawn on the basemap; runs again after the basemap changes with the theme, which
    // drops all added sources and layers
    async function build() {
      if (country) map.setProjection({ type: "mercator" });
      else if (chosen.globe && !single) map.setProjection({ type: "globe" }); // a new basemap starts flat
      await icons();
      addReports();
      addAccuracy();
      addLandrace();
      await addMask();
    }

    // a country page: everything but the country greyed out and its border highlighted, under the
    // markers. The outline is a small static file (/api/mask/<id>.json); a state has none.
    let maskData: any = null;
    async function addMask() {
      if (!country || country.includes("/") || map.getSource("mask")) return;
      if (!maskData) maskData = await fetch(`${base}api/mask/${country}.json`).then((r) => (r.ok ? r.json() : false)).catch(() => false);
      if (!maskData || map.getSource("mask")) return;
      const c = INK[theme()];
      map.addSource("mask", { type: "geojson", data: { type: "FeatureCollection", features: [
        { type: "Feature", properties: { kind: "mask" }, geometry: maskData.mask },
        { type: "Feature", properties: { kind: "border" }, geometry: { type: "MultiLineString", coordinates: maskData.geometry.coordinates.flat() } },
      ] } as any });
      const below = map.getLayer("accuracy-fill") ? "accuracy-fill" : LAYERS.area.find((id) => map.getLayer(id)) ?? "clusters";
      map.addLayer({ id: "mask", type: "fill", source: "mask", filter: ["==", ["get", "kind"], "mask"], paint: { "fill-color": c.bg, "fill-opacity": theme() === "dark" ? 0.6 : 0.62 } }, below);
      // the country's border, highlighted: a soft wide halo under a crisp line
      map.addLayer({ id: "border-halo", type: "line", source: "mask", filter: ["==", ["get", "kind"], "border"], layout: { "line-join": "round" }, paint: { "line-color": c.ink, "line-width": 6, "line-opacity": 0.12, "line-blur": 2 } }, below);
      map.addLayer({ id: "border", type: "line", source: "mask", filter: ["==", ["get", "kind"], "border"], layout: { "line-join": "round" }, paint: { "line-color": c.ink, "line-width": 1.6, "line-opacity": 0.85 } }, below);
    }

    // the area the report may have happened in: a shaded circle with a dashed edge, under the markers
    function addAccuracy() {
      if (!accuracy || map.getSource("accuracy")) return;
      const c = INK[theme()];
      const [lon, lat] = accuracy.center, ring: [number, number][] = [];
      for (let i = 0; i <= 64; i++) {
        const a = (i / 64) * 2 * Math.PI;
        ring.push([lon + (accuracy.km / (111.32 * Math.cos((lat * Math.PI) / 180))) * Math.cos(a), lat + (accuracy.km / 110.57) * Math.sin(a)]);
      }
      map.addSource("accuracy", { type: "geojson", data: { type: "Feature", properties: {}, geometry: { type: "Polygon", coordinates: [ring] } } });
      map.addLayer({ id: "accuracy-fill", type: "fill", source: "accuracy", paint: { "fill-color": c.ink, "fill-opacity": theme() === "dark" ? 0.12 : 0.08 } }, "clusters");
      map.addLayer({ id: "accuracy-line", type: "line", source: "accuracy", paint: { "line-color": c.ink, "line-width": 1.2, "line-opacity": 0.55, "line-dasharray": [2, 2] } }, "clusters");
    }

    // the report markers, grouped into clusters only when the reader chose it; a "clusters" layer is
    // always there (empty without grouping), as the Landrace layers are placed under it
    const REPORT_LAYERS = ["reports", "focus", "hover", "cluster-count", "clusters"];
    function addReports() {
      const c = INK[theme()];
      map.addSource("reports", { type: "geojson", data: geojson(shown), cluster: chosen.cluster, clusterRadius: 26, clusterMaxZoom: 5 });
      // clusters: a neutral disc with the number of reports
      map.addLayer({
        id: "clusters", type: "circle", source: "reports", filter: ["has", "point_count"],
        paint: { "circle-color": c.ink, "circle-opacity": 0.85, "circle-stroke-color": c.bg, "circle-stroke-width": 1.5 * markerScale, "circle-radius": ["step", ["get", "point_count"], 11 * markerScale, 10, 15 * markerScale, 50, 20 * markerScale, 250, 26 * markerScale] },
      });
      map.addLayer({
        id: "cluster-count", type: "symbol", source: "reports", filter: ["has", "point_count"],
        layout: { "text-field": ["get", "point_count_abbreviated"], "text-font": ["Noto Sans Regular"], "text-size": 11.5 * markerScale, "text-allow-overlap": true },
        paint: { "text-color": c.bg },
      });
      const ring = (r: number, w: number) => ({ "circle-radius": r * markerScale, "circle-color": theme() === "dark" ? "rgba(242,240,233,.16)" : "rgba(17,17,15,.10)", "circle-stroke-color": c.ink, "circle-stroke-width": w * markerScale });
      // a ring under the report the reader points at in a list, and under the one this page is about
      map.addLayer({ id: "hover", type: "circle", source: "reports", filter: ["==", ["get", "id"], hovered], paint: ring(18, 2) });
      // (a report page's own map shows its accuracy circle instead)
      map.addLayer({ id: "focus", type: "circle", source: "reports", filter: single ? ["==", ["get", "id"], ""] : ["all", ["!", ["has", "point_count"]], ["get", "focus"]], paint: ring(17, 1.5) });
      map.addLayer({
        id: "reports", type: "symbol", source: "reports", filter: ["!", ["has", "point_count"]],
        layout: {
          "icon-image": ["concat", "t-", ["get", "t"]],
          "icon-size": ["interpolate", ["linear"], ["zoom"], 1, 0.85 * markerScale, 6, markerScale, 10, 1.15 * markerScale],
          "icon-allow-overlap": true, "icon-ignore-placement": true,
          "symbol-sort-key": ["case", ["get", "focus"], 1, 0],
        },
        paint: { "icon-opacity": single ? ["case", ["get", "focus"], 1, FADE] : 1 },
      });
    }
    // switching grouping on or off: a GeoJSON source cannot change that, so the markers are redrawn
    function regroup() {
      for (const id of REPORT_LAYERS) if (map.getLayer(id)) map.removeLayer(id);
      if (map.getSource("reports")) map.removeSource("reports");
      addReports();
    }

    const showLandrace = async (kind: string, on: boolean) => {
      if (on) {
        await Promise.all(NEEDS[kind].filter((k) => !loaded[k]).map(async (k) => { loaded[k] = await fetch(`${base}layers/${FILES[k]}`).then((r) => r.json()); }));
        if (map.getLayer("clusters")) addLandrace();
      }
      for (const id of LAYERS[kind]) if (map.getLayer(id)) map.setLayoutProperty(id, "visibility", chosen[kind] ? "visible" : "none");
    };

    const basemapReady = new Promise<void>((resolve, reject) => {
      const failed = (event: any) => {
        if (!map.getStyle()) { map.off("error", failed); reject(event.error); }
      };
      map.on("error", failed);
      map.once("load", () => { map.off("error", failed); resolve(); });
    });
    Promise.all([loadIndex(base), basemapReady]).then(async ([idx]) => {
      index = idx;
      rows = country ? idx.reports.filter((r) => inCountry(r, country)) : idx.reports;
      const pre: Set<string> | undefined = (window as any).__reportsShown; // filters that ran before the map
      shown = pre ? rows.filter((r) => pre.has(r.i)) : rows;
      await initialLayers;
      await build();
      // Country bounds are supplied in the HTML so the first camera is already
      // final. Subdivisions without an outline use their report points instead.
      if (country && !countryBounds) {
        const extent = pointBounds(rows.filter(r => r.ll).map(r => r.ll!));
        if (extent) map.fitBounds([[extent[0], extent[1]], [extent[2], extent[3]]], { padding: 40, maxZoom: 6, duration: 0 });
      }
      map.once("idle", reveal);
      if (map.loaded()) reveal();

      // remember the reader's choice of flat map or globe
      box.querySelector(".maplibregl-ctrl-globe, .maplibregl-ctrl-globe-enabled")?.addEventListener("click", () => setTimeout(() => {
        chosen.globe = map.getProjection()?.type === "globe";
        try { localStorage.setItem(KEY, JSON.stringify(chosen)); } catch {}
      }));
      if (single) for (const kind of ["area", "region", "accession"]) showLandrace(kind, true);
      const group = box.querySelector<HTMLInputElement>('[data-option="cluster"]');
      if (group) group.checked = chosen.cluster;
      group?.addEventListener("change", () => {
        chosen.cluster = group!.checked;
        try { localStorage.setItem(KEY, JSON.stringify(chosen)); } catch {}
        regroup();
      });
      for (const input of box.querySelectorAll<HTMLInputElement>("[data-layer]")) {
        const kind = input.dataset.layer!;
        input.checked = chosen[kind];
        if (input.checked) showLandrace(kind, true);
        input.addEventListener("change", () => {
          chosen[kind] = input.checked;
          try { localStorage.setItem(KEY, JSON.stringify(chosen)); } catch {}
          showLandrace(kind, input.checked);
        });
      }

      // Hover boxes and clicks: one handler for the whole map, which looks under the pointer in a fixed
      // order, so a report always wins over everything else: a report marker (with a few pixels of
      // slack, as the diamonds are small), a cluster, then the Landrace layers from the smallest thing
      // to the largest (an accession, an area, a region). Layers are looked up by name on every move,
      // so this keeps working after the basemap or the grouping changes.
      const popup = new maplibregl.Popup({ closeButton: false, closeOnClick: false, offset: 10, maxWidth: "300px", className: "map-tip" });
      // what a Landrace hover box says: for an area or region its status, place, description and facts
      // from its Landrace.wiki infobox; for an accession its place, year and seed lot status
      const LOT_COLOR: Record<string, string> = { Urgent: "#c92a2a", "At risk": "#e67700", Secure: "#0ca678", "Held in a genebank": "#4c6ef5", "Data deficient": "#6c757d" };
      const LOT_LABEL: Record<string, string> = { "Data deficient": "No data yet, or too little to rate", "Held in a genebank": "Held in a genebank, not distributed" };
      const num = (n: number) => n.toLocaleString("en-GB");
      const clip = (s: string, n = 220) => (s.length > n ? `${s.slice(0, s.lastIndexOf(" ", n))}…` : s);
      const landraceBox = (p: any) => {
        if (p.kind === "accession") {
          const lot = p.lot ? `<span class="tip-lot"><i style="background:${LOT_COLOR[p.lot] ?? "#6c757d"}"></i>Seed lot: ${esc(LOT_LABEL[p.lot] ?? p.lot)}</span>` : `<span class="tip-lot"><i class="hollow"></i>No seed lot recorded</span>`;
          return `<span class="type landrace">Landrace accession${p.year ? `, collected ${p.year}` : ""}</span><strong>${esc(p.name)}</strong>`
            + `<span class="muted">${esc([p.area, p.country].filter(Boolean).join(" · "))}</span>${lot}<span class="muted tip-src">Landrace.wiki</span>`;
        }
        const what = p.kind === "area" ? "Landrace growing area" : "Landrace growing region";
        const status = p.status ? ` · <b class="tip-status ${p.status === "Active" ? "on" : ""}">${esc(p.status)}</b>` : "";
        const where = [p.countries ?? p.country, p.provinces].filter(Boolean).join(" · ");
        const elev = p.elev_min != null && p.elev_max != null ? `${num(p.elev_min)}–${num(p.elev_max)} m` : p.elev_max != null ? `up to ${num(p.elev_max)} m` : null;
        const facts = [elev, p.climate, p.mountains && `${p.mountains} mountains`, p.extent_km2 && `${num(p.extent_km2)} km²`].filter(Boolean);
        const acc = p.accessions ? `${num(p.accessions)} accession${p.accessions === 1 ? "" : "s"} · ` : "";
        return `<span class="type landrace">${what}${status}</span><strong>${esc(p.name)}</strong>`
          + (where ? `<span class="muted">${esc(where)}</span>` : "")
          + (p.description ? `<span class="tip-desc">${esc(clip(p.description))}</span>` : "")
          + (facts.length ? `<span class="tip-facts">${esc(facts.join(" · "))}</span>` : "")
          + `<span class="muted tip-src">${acc}Landrace.wiki</span>`;
      };
      const ORDER = ["reports", "clusters", "landrace-accession", "landrace-area-dot", "landrace-area-fill", "landrace-region-fill"];
      const SLACK: Record<string, number> = { reports: 5, clusters: 2, "landrace-accession": 3 };
      const hitAt = (pt: maplibregl.Point) => {
        for (const layer of ORDER) {
          if (!map.getLayer(layer) || map.getLayoutProperty(layer, "visibility") === "none") continue;
          const s = SLACK[layer] ?? 0;
          const box: [maplibregl.PointLike, maplibregl.PointLike] = [[pt.x - s, pt.y - s], [pt.x + s, pt.y + s]];
          const f = map.queryRenderedFeatures(s ? box : pt, { layers: [layer] })[0];
          if (f) return { layer, f };
        }
        return null;
      };
      let current = "";
      // no hover boxes on a report page's small map: it shows one place, not a map to explore
      if (!single) map.on("mousemove", (e) => {
        const hit = hitAt(e.point);
        if (!hit) { if (current) { popup.remove(); current = ""; map.getCanvas().style.cursor = ""; } return; }
        const { layer, f } = hit, p = f.properties as any;
        map.getCanvas().style.cursor = layer === "clusters" ? "zoom-in" : "pointer";
        if (layer === "clusters") { popup.remove(); current = "cluster"; return; }
        const key = `${layer}:${p.id ?? p.url ?? p.name}`;
        const point = f.geometry.type === "Point" ? (f.geometry as any).coordinates : e.lngLat;
        if (key === current && f.geometry.type === "Point") return; // the same marker: leave the box where it is
        current = key;
        const html = layer === "reports"
          ? `<span class="type" style="--c:${esc(p.color)}">${esc(p.type)}</span><strong>${esc(p.title)}</strong><span class="muted">${esc(p.place)}<br>${esc(p.date)}</span>`
          : landraceBox(p);
        popup.setLngLat(point).setHTML(html).addTo(map);
      });
      map.getCanvas().addEventListener("mouseleave", () => { popup.remove(); current = ""; });
      map.on("click", async (e) => {
        const hit = hitAt(e.point);
        if (!hit) return;
        const { layer, f } = hit, p = f.properties as any;
        if (layer === "reports") location.href = `${base}report/${p.id}/`;
        else if (layer === "clusters") {
          const zoom = await (map.getSource("reports") as maplibregl.GeoJSONSource).getClusterExpansionZoom(p.cluster_id);
          map.jumpTo({ center: (f.geometry as any).coordinates, zoom });
        } else if (p.url) window.open(p.url, "_blank", "noopener");
      });

      // the home page's filters and list
      document.addEventListener("reports:filter", ((e: CustomEvent<Set<string>>) => {
        shown = rows.filter((r) => e.detail.has(r.i));
        (map.getSource("reports") as maplibregl.GeoJSONSource | undefined)?.setData(geojson(shown));
      }) as EventListener);
      // the zoom icon in the list: jump to the report, ring it and show its hover box
      document.addEventListener("reports:zoom", ((e: CustomEvent<string>) => {
        const r = rows.find((x) => x.i === e.detail);
        if (!r?.ll) return;
        hovered = r.i;
        if (map.getLayer("hover")) map.setFilter("hover", ["==", ["get", "id"], hovered]);
        // close in as far as the place is known: a spot, a town, a district, a region or only the country
        const zoom = ({ exact: 11, locality: 9, district: 8, region: 6, country: 4 } as Record<string, number>)[r.pr ?? "country"] ?? 6;
        map.jumpTo({ center: r.ll, zoom });
        popup.setLngLat(r.ll!).setHTML(`<span class="type" style="--c:${esc(types[r.t].color)}">${esc(types[r.t].label)}</span><strong>${esc(r.ti)}</strong><span class="muted">${esc([r.p, index.countries[r.c]].filter(Boolean).join(" · "))}<br>${esc(fmtDate(r.d))}</span>`).addTo(map);
        current = `reports:${r.i}`;
        if (matchMedia("(max-width: 860px)").matches) box.scrollIntoView({ behavior: "instant", block: "start" });
      }) as EventListener);
      document.addEventListener("reports:hover", ((e: CustomEvent<string | null>) => {
        hovered = e.detail ?? "";
        if (map.getLayer("hover")) map.setFilter("hover", ["==", ["get", "id"], hovered]);
      }) as EventListener);
      // the home page opened from a report's "big map" link: jump there, ring it, show its hover box
      if (focus && !single) document.dispatchEvent(new CustomEvent("reports:zoom", { detail: focus }));
      // the site's theme switch: the other basemap, then everything drawn on it again
      document.addEventListener("theme:change", () => {
        map.setStyle(styles[theme()], { diff: false });
        map.once("style.load", build);
      });
    }).catch(() => {
      clearTimeout(slow);
      const label = box.querySelector(".map-loading-label");
      if (label) label.textContent = "Map could not be loaded. Please reload to try again.";
      box.setAttribute("aria-busy", "false");
    });
  }
</script>

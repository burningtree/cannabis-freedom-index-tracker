---
// The map with one dot per report, coloured by type: MapLibre GL JS on OpenFreeMap's dark vector
// tiles (src/lib/map.js). The reports go to the page as GeoJSON; the script draws them, shows a
// hover box and opens a report on click. `focus` centres the map on one report (the report page),
// `fit` zooms to all the reports given (a country page), otherwise the whole world is shown. The
// home page's filters hide dots through the "reports:filter" event.
import { MAP_STYLE } from "../lib/map.js";
import { formatDate } from "../lib/reports.js";
const { reports, focus = null, fit = false, label = "Map of reports" } = Astro.props;
const base = import.meta.env.BASE_URL;
const ZOOM = { exact: 9, locality: 8, district: 7, region: 5, country: 4 };
const data = {
  type: "FeatureCollection",
  features: reports.filter((r) => r.coordinates).map((r) => ({
    type: "Feature",
    geometry: { type: "Point", coordinates: [r.coordinates[1], r.coordinates[0]] },
    properties: {
      id: r.id, url: `${base}${r.url}`, title: r.title, type: r.typeLabel, color: r.color,
      date: formatDate(r.date), place: [r.place, r.countryName].filter(Boolean).join(" · "),
      focus: focus?.id === r.id,
    },
  })),
};
const view = focus?.coordinates ? { center: [focus.coordinates[1], focus.coordinates[0]], zoom: ZOOM[focus.precision] ?? 5 } : null;
---
<div class="map" data-map data-style={MAP_STYLE} data-view={view ? JSON.stringify(view) : undefined} data-fit={fit ? "" : undefined} role="region" aria-label={label}>
  <script type="application/json" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
</div>

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";

  const esc = (s = "") => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  for (const box of document.querySelectorAll<HTMLElement>("[data-map]")) {
    const data = JSON.parse(box.querySelector("script")!.textContent!);
    // the whole inhabited world, fitted to the box, unless a report or a country is in focus
    const view = box.dataset.view ? JSON.parse(box.dataset.view) : { bounds: [[-168, -50], [178, 72]] as [[number, number], [number, number]] };
    const map = new maplibregl.Map({
      container: box, style: box.dataset.style!, ...view,
      minZoom: -1, maxZoom: 14, renderWorldCopies: false, // on a phone, or a small map inside a page, one finger or the wheel scrolls the page
      cooperativeGestures: box.dataset.view != null || matchMedia("(pointer: coarse)").matches,
      attributionControl: { compact: true },
    });
    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");
    if (box.dataset.fit != null && data.features.length) {
      const b = new maplibregl.LngLatBounds();
      data.features.forEach((f: any) => b.extend(f.geometry.coordinates));
      map.fitBounds(b, { padding: 60, maxZoom: 5, duration: 0 });
    }

    map.on("load", () => {
      map.addSource("reports", { type: "geojson", data });
      map.addLayer({
        id: "reports", type: "circle", source: "reports",
        paint: {
          "circle-color": ["get", "color"],
          "circle-radius": ["interpolate", ["linear"], ["zoom"], 1, ["case", ["get", "focus"], 7, 5], 8, ["case", ["get", "focus"], 11, 8]],
          "circle-stroke-color": ["case", ["get", "focus"], "#f2f0e9", "#0c0c0b"],
          "circle-stroke-width": ["case", ["get", "focus"], 2.5, 1.2],
        },
      });

      // the hover box
      const popup = new maplibregl.Popup({ closeButton: false, closeOnClick: false, offset: 10, maxWidth: "280px", className: "map-tip" });
      map.on("mouseenter", "reports", (e) => {
        map.getCanvas().style.cursor = "pointer";
        const f = e.features![0], p = f.properties as any;
        popup.setLngLat((f.geometry as any).coordinates)
          .setHTML(`<span class="type" style="--c:${esc(p.color)}">${esc(p.type)}</span><strong>${esc(p.title)}</strong><span class="muted">${esc(p.place)}<br>${esc(p.date)}</span>`)
          .addTo(map);
      });
      map.on("mouseleave", "reports", () => { map.getCanvas().style.cursor = ""; popup.remove(); });
      map.on("click", "reports", (e) => { location.href = (e.features![0].properties as any).url; });

      // the home page's filters say which reports to show
      const filter = (ids: Set<string>) => map.setFilter("reports", ["in", ["get", "id"], ["literal", [...ids]]]);
      document.addEventListener("reports:filter", ((e: CustomEvent<Set<string>>) => filter(e.detail)) as EventListener);
      if ((window as any).__reportsShown) filter((window as any).__reportsShown);
    });
  }
</script>

---
// The filterable list of reports: free text, type, country, year, month and day, a strip of reports per
// month, and "Show more". The newest reports are in the page itself (for readers without scripts and
// for search engines); filtering and paging work on the shared index of all reports
// (/api/index.json). Used by the map's side pane (compact) and by the Reports page. The filters also
// narrow the map's markers ("reports:filter") and pointing at a report rings its marker
// ("reports:hover") where a map is on the page. With country, it lists only that country's reports
// (a country page): the country is fixed, not a filter.
import ReportItem from "./ReportItem.astro";
import ReportYears from "./ReportYears.astro";
import { reports, reportsOf, years } from "../lib/reports.js";
import { countries } from "../lib/countries.js";
import { TYPES } from "../lib/types.js";

const { page: PAGE = 30, compact = false, country = null } = Astro.props;
const all = country ? reportsOf(country) : reports;
const allYears = country ? [...new Set(all.map((r) => r.year))].sort((a, b) => b - a) : years;
// All CFI countries and territories, with their states underneath, including zero counts.
const places = countries.filter((c) => !c.parent).sort((a, b) => a.name.localeCompare(b.name))
  .flatMap((c) => [{ id: c.id, name: c.name, count: reportsOf(c.id).length },
    ...countries.filter((s) => s.parent === c.id).map((s) => ({ id: s.id, name: `\u2003${s.name}`, count: reportsOf(s.id).length }))]);
const usedTypes = Object.entries(TYPES).filter(([t]) => all.some((r) => r.type === t || r.also?.includes(t)));
const fmt = (n) => n.toLocaleString("en-GB");
const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const base = import.meta.env.BASE_URL;
const types = Object.fromEntries(Object.entries(TYPES).map(([k, v]) => [k, { label: v.label, color: v.color }]));
---
<div class:list={["browser", { compact }]}>
  <form class="filters" role="search" onsubmit="return false">
    <input type="search" id="q" placeholder="Search reports, places, tags…" aria-label="Search" />
    <select id="type" aria-label="Type">
      <option value="">All types</option>
      {usedTypes.map(([id, v]) => <option value={id}>{v.plural}</option>)}
    </select>
    {country
      ? <input type="hidden" id="country" value={country} data-fixed />
      : <select id="country" aria-label="Country">
          <option value="">All countries</option>
          {places.map((c) => <option value={c.id}>{c.name} ({c.count})</option>)}
        </select>}
    <div class="time-filter">
      <label for="period">Time</label>
      <select id="period" aria-label="Time period" aria-controls="calendar-filters">
        {compact && <>
          <option value="7d">Last 7 days</option>
          <option value="30d" selected>Last 30 days</option>
          <option value="1y">Last year</option>
        </>}
        <option value="all" selected={!compact}>All time</option>
        <option value="calendar">Calendar dates…</option>
      </select>
      <div class="calendar-filters" id="calendar-filters" hidden>
        <select id="year" aria-label="Year">
          <option value="">All years</option>
          {allYears.map((y) => <option value={y}>{y}</option>)}
        </select>
        <select id="month" aria-label="Month">
          <option value="">All months</option>
          {MONTHS.map((m, i) => <option value={String(i + 1).padStart(2, "0")}>{m}</option>)}
        </select>
      </div>
    </div>
    <button class="clear-filters" id="clear-filters" type="button" hidden>Clear all filters ×</button>
  </form>
  {/* drawn by the script; its height is kept from the start so the page does not jump when it loads */}
  <div class="months" id="months" aria-label="Reports over time, stacked by primary category" aria-busy="true"></div>
  <p class="day-filter" id="day-filter" hidden>
    <span id="day-filter-label"></span>
    <button type="button" id="clear-day" aria-label="Clear the selected day">Clear day ×</button>
  </p>
  <p class="count" id="count" aria-live="polite">{fmt(all.length)} reports · newest first</p>
  {/* the map's side pane: one plain list; the Reports page: by year, with a sticky month index */}
  {compact
    ? <ul class="reports" id="list" data-base={base} data-types={JSON.stringify(types)} data-page={PAGE}>
        {all.slice(0, PAGE).map((r) => <ReportItem r={r} search={false} zoom />)}
      </ul>
    : <div class="ry-all" id="list" data-years data-base={base} data-types={JSON.stringify(types)} data-page={PAGE}>
        <ReportYears reports={all.slice(0, PAGE)} />
      </div>}
  <p class="empty" id="empty" hidden={all.length > 0}>No report matches these filters.</p>
  {!compact && <>
    <div id="report-scroll-sentinel" aria-hidden="true" hidden></div>
    <p class="count" id="scroll-status" role="status" aria-live="polite"></p>
  </>}
  <p class="more-row">
    <button type="button" class="more" id="more" hidden={all.length <= PAGE}>Show more</button>
    {!country && <a class="muted" href={`${base}${years[0] ?? ""}/`}>Browse by month →</a>}
  </p>
</div>

<script>
  // Filters: free text, type, country, year, month and exact day. They narrow the list and map and
  // are kept in the address (?type=raid&country=ng&year=2026), so a filtered view can be shared.
  import { loadIndex, inCountry, type Row } from "../scripts/report-index";
  import { yearsHTML, appendYears } from "../scripts/report-years.js";
  import { reportTimeline, timelineSelection, axisTicks } from "../scripts/report-timeline.js";
  import { readPeriod, changePeriod } from "../scripts/report-period.js";
  import { timelineTooltip } from "../scripts/report-timeline-tooltip.js";
  import { imageProxy } from "../lib/media.js";

  const $ = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as T;
  const list = $<HTMLElement>("list");
  const byYear = list.dataset.years != null; // the Reports page: grouped by year and month
  const base = list.dataset.base!, PAGE = Number(list.dataset.page), types = JSON.parse(list.dataset.types!);
  // a country page lists one country's reports: the country is fixed, never a filter or in the address
  const fixedCountry = $("country").dataset.fixed != null ? $("country").value : "";
  const fields = ["q", "type", ...(fixedCountry ? [] : ["country"]), "year", "month"];
  const params = new URLSearchParams(location.search);
  let day = "";
  const hideTimelineTooltip = timelineTooltip($("months"), types);
  for (const f of fields) if (params.get(f)) $(f).value = params.get(f)!;
  // One Time control owns both rolling periods and calendar selections.
  const RANGES: Record<string, number> = { "7d": 7, "30d": 30, "1y": 365, all: 0 };
  const DEFAULT_RANGE = list.closest(".compact") ? "30d" : "all";
  let period = readPeriod(params, DEFAULT_RANGE, { allowRelative: !byYear });
  let range = period.range;
  const setPeriod = (next: ReturnType<typeof readPeriod>) => {
    period = next; range = next.range; day = next.date;
    $("year").value = next.year; $("month").value = next.month;
    $("period").value = next.mode;
    $("calendar-filters").hidden = next.mode !== "calendar";
    document.querySelectorAll<HTMLButtonElement>("[data-range]").forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.range === next.mode));
    });
  };
  setPeriod(period);
  const since = () => (RANGES[range] ? new Date(Date.now() - RANGES[range] * 864e5).toISOString().slice(0, 10) : "");

  function showCustomSearch() {
    const banner = document.getElementById("map-search");
    if (!banner) return;
    const active = fields.filter((f) => $(f).value.trim());
    banner.hidden = active.length === 0 && !day;
    const labels = active.map((f) => {
      const field = $(f);
      return field instanceof HTMLSelectElement ? field.selectedOptions[0].textContent!.trim() : `“${field.value.trim()}”`;
    });
    if (day) labels.push(fmtDate(day));
    $("map-search-summary").textContent = labels.join(" · ");
  }

  const esc = (s = "") => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const fmtDate = (d: string) => new Date(`${d}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
  const flag = (id: string) => { const cc = id.split("/")[0].toUpperCase(); return /^[A-Z]{2}$/.test(cc) ? String.fromCodePoint(...[...cc].map((ch) => 0x1f1a5 + ch.charCodeAt(0))) : ""; };

  let rows: Row[] = [], countries: Record<string, string> = {}, haystack = new Map<Row, string>();
  let shown: Row[] = [], limit = PAGE, renderedCount = 0;
  let scrollObserver: IntersectionObserver | null = null;

  // a photo the publisher no longer serves is removed, and its row drawn without it
  const thumb = (r: Row) => r.im ? `<img class="thumb" src="${esc(imageProxy(r.im))}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.parentElement.classList.remove('has-thumb');this.remove()">` : "";
  const item = (r: Row) => `<li class="report-item${r.im ? " has-thumb" : ""}" data-id="${r.i}">
    <div class="meta"><span class="type" style="--c:${types[r.t].color}">${esc(types[r.t].label)}</span>
      <time datetime="${r.d}">${fmtDate(r.d)}</time>
      <a href="${base}country/${r.c}/">${flag(r.c)} ${esc(countries[r.c])}</a></div>
    <h3><a href="${base}report/${r.i}/">${esc(r.ti)}</a>${zoomable && r.ll ? `<button type="button" class="zoom-to" data-zoom="${r.i}" aria-label="Show on the map" title="Show on the map"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="8" cy="8" r="1.6" fill="currentColor"/><path d="M8 0.5v3M8 12.5v3M0.5 8h3M12.5 8h3" stroke="currentColor" stroke-width="1.5"/></svg></button>` : ""}</h3>
    ${thumb(r)}<p>${esc(r.s)}</p>
    ${r.f.length ? `<div class="figs-inline">${r.f.map(([l, v]) => `<span>${esc(l)} <b>${esc(v)}</b></span>`).join("")}</div>` : ""}
  </li>`;

  function matches(r: Row, skipDay = false) {
    const q = $("q").value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    const type = $("type").value, country = $("country").value, year = $("year").value, month = $("month").value;
    return (!type || r.t === type || r.a.includes(type))
      && (!country || inCountry(r, country))
      && (!year || r.d.startsWith(year)) && (!month || r.d.slice(5, 7) === month)
      && (!since() || (r.d >= since() && r.d <= new Date().toISOString().slice(0, 10)))
      && (skipDay || !day || r.d === day)
      && q.every((w) => haystack.get(r)!.includes(w));
  }

  function render(append = false) {
    if (append) {
      const batch = shown.slice(renderedCount, limit);
      if (byYear) appendYears(list, batch, shown, item, base);
      else list.insertAdjacentHTML("beforeend", batch.map(item).join(""));
    } else {
      list.innerHTML = byYear ? yearsHTML(shown.slice(0, limit), shown, item, base) : shown.slice(0, limit).map(item).join("");
    }
    renderedCount = Math.min(limit, shown.length);
    document.dispatchEvent(new CustomEvent("reports:drawn"));
    const finished = renderedCount >= shown.length;
    $("more").hidden = finished || !!scrollObserver;
    const sentinel = document.getElementById("report-scroll-sentinel");
    if (sentinel) {
      sentinel.hidden = !scrollObserver || finished;
      if (scrollObserver) {
        scrollObserver.unobserve(sentinel);
        if (!finished) requestAnimationFrame(() => scrollObserver?.observe(sentinel));
      }
    }
    const status = document.getElementById("scroll-status");
    if (status) status.textContent = !shown.length ? "" : finished
      ? `All ${shown.length.toLocaleString("en-GB")} ${shown.length === 1 ? "report" : "reports"} shown`
      : `${renderedCount.toLocaleString("en-GB")} of ${shown.length.toLocaleString("en-GB")} reports shown · scroll for more`;
    $("empty").hidden = shown.length > 0;
    $("day-filter").hidden = !day;
    $("day-filter-label").textContent = day ? `Day: ${fmtDate(day)}` : "";
    const active = fields.some((f) => $(f).value) || !!day || range !== "all";
    $("clear-filters").hidden = !active && period.mode !== "calendar";
    const n = shown.length.toLocaleString("en-GB"), all = rows.length.toLocaleString("en-GB");
    const when = ({ "7d": "in the last 7 days", "30d": "in the last 30 days", "1y": "in the last 12 months" } as Record<string, string>)[range];
    const other = fields.some((f) => $(f).value) || !!day;
    $("count").textContent = !active ? `${all} reports · newest first`
      : when && !other ? `${n} ${shown.length === 1 ? "report" : "reports"} ${when} · ${all} in all`
      : `${n} of ${all} reports${day ? ` · ${fmtDate(day)}` : when ? ` ${when}` : ""}`;
  }

  // The chart shares the map's filters, including its selected time window.
  function months() {
    const daily = range === "7d" || range === "30d" || !!$("month").value || !!day;
    // all time over five years or more: a bar per year; a shorter history: a bar per month
    const matching = rows.filter((r) => matches(r, true)), dates = matching.map((r) => r.d).sort();
    const longHistory = dates.length > 0 && Number(dates.at(-1)!.slice(0, 4)) - Number(dates[0].slice(0, 4)) >= 5;
    const yearly = range === "all" && !$("year").value && !daily && longHistory;
    const dayCalendar = day && range !== "7d" && range !== "30d";
    const series = reportTimeline(matching, {
      start: since(), end: new Date().toISOString().slice(0, 10),
      year: $("year").value || (dayCalendar ? day.slice(0, 4) : ""),
      month: $("month").value || (dayCalendar ? day.slice(5, 7) : ""), daily, yearly,
    });
    const box = $("months");
    box.removeAttribute("aria-busy");
    lastSeries = series; lastScale = yearly ? "year" : daily ? "day" : "month";
    if (!series.length) { box.innerHTML = ""; return; }
    const max = Math.max(1, ...series.map(b => b.total));
    box.dataset.caption = `Reports per ${yearly ? "year" : daily ? "day" : "month"}`;
    box.setAttribute("aria-label", `Reports per ${yearly ? "year" : daily ? "day" : "month"}, stacked by primary category; choose a bar to filter by ${yearly ? "year" : daily ? "day" : "month"}`);
    box.innerHTML = series.map(({ key, total, categories }) => {
      const label = new Date(`${yearly ? `${key}-01-01` : daily ? key : `${key}-01`}T00:00:00Z`).toLocaleDateString("en-GB", {
        ...(daily ? { day: "numeric" as const } : {}), ...(!yearly ? { month: "short" as const } : {}), year: "numeric", timeZone: "UTC",
      });
      const breakdown = Object.entries(types).filter(([id]) => categories[id]).map(([id, value]: [string, any]) => `${value.label}: ${categories[id]}`).join(", ");
      const description = `${label}: ${total} report${total === 1 ? "" : "s"}${breakdown ? ` (${breakdown})` : ""}`;
      const selected = daily ? day === key : yearly ? $("year").value === key : `${$("year").value}-${$("month").value}` === key;
      return `<button type="button" data-m="${key}" data-period="${yearly ? "year" : daily ? "day" : "month"}" data-period-label="${esc(label)}" data-total="${total}" data-categories="${esc(JSON.stringify(categories))}" aria-pressed="${selected}" aria-label="${esc(description)}"><span class="month-stack" style="height:${total / max * 100}%">${Object.entries(types).filter(([id]) => categories[id]).map(([id, value]: [string, any]) => `<i data-category="${id}" style="height:${categories[id] / total * 100}%;background:${value.color}"></i>`).join("")}</span></button>`;
    }).join("") + (byYear ? `<span class="months-scale" aria-hidden="true">${max.toLocaleString("en-GB")}</span>` : "") + `<span class="months-axis" aria-hidden="true"></span>`;
    drawAxis();
  }

  // the x axis: as many period labels as fit the chart's width, at round steps (every year, 5 years;
  // every month, quarter; every day, week), redrawn when the width changes
  let lastSeries: { key: string }[] = [], lastScale = "month";
  function drawAxis() {
    const axis = $("months").querySelector<HTMLElement>(".months-axis");
    if (!axis || !lastSeries.length) return;
    const n = lastSeries.length;
    axis.innerHTML = axisTicks(lastSeries.map((b) => b.key), lastScale, $("months").clientWidth).map(({ index, label }) =>
      `<span style="left:${((index + 0.5) / n) * 100}%">${esc(label)}</span>`).join("");
  }
  if ("ResizeObserver" in window) {
    let width = 0;
    new ResizeObserver(([entry]) => {
      if (Math.abs(entry.contentRect.width - width) < 4) return;
      width = entry.contentRect.width;
      drawAxis();
    }).observe($("months"));
  }

  function apply(resetLimit = true) {
    hideTimelineTooltip();
    if (resetLimit) limit = PAGE;
    showCustomSearch();
    shown = rows.filter((r) => matches(r));
    render();
    months();
    (window as any).__reportsShown = new Set(shown.map((r) => r.i)); // for a map that loads later
    document.dispatchEvent(new CustomEvent("reports:filter", { detail: (window as any).__reportsShown }));
    const p = new URLSearchParams();
    for (const f of fields) if ($(f).value) p.set(f, $(f).value);
    if (day) p.set("date", day);
    if (period.mode !== DEFAULT_RANGE) p.set("range", period.mode);
    history.replaceState(null, "", (p.size ? `?${p}` : location.pathname) + location.hash); // the hash is the map's view
  }

  // the target icon beside a title (where a map is on the page) flies the map to the report
  const zoomable = list.querySelector(".zoom-to") != null || (list.closest(".compact") != null && document.querySelector("[data-map]") != null);
  list.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".zoom-to");
    if (b) document.dispatchEvent(new CustomEvent("reports:zoom", { detail: b.dataset.zoom }));
  });
  // a month in a year's index that is not drawn yet: draw down to it, then go there
  list.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>(".ry-months a");
    if (!a || document.getElementById(a.hash.slice(1))) return;
    const month = a.hash.slice(2), at = shown.findIndex((r) => r.d.startsWith(month));
    if (at < 0) return;
    e.preventDefault();
    limit = Math.max(limit, at + PAGE);
    render();
    document.getElementById(a.hash.slice(1))?.scrollIntoView({ behavior: "instant" });
    history.replaceState(null, "", location.pathname + location.search + a.hash);
  });
  // pointing at a report in the list rings its marker on the map
  const hover = (id: string | null) => document.dispatchEvent(new CustomEvent("reports:hover", { detail: id }));
  list.addEventListener("mouseover", (e) => hover((e.target as HTMLElement).closest<HTMLElement>(".report-item")?.dataset.id ?? null));
  list.addEventListener("mouseleave", () => hover(null));

  loadIndex(base).then((idx) => {
    rows = fixedCountry ? idx.reports.filter((r) => inCountry(r, fixedCountry)) : idx.reports; countries = idx.countries;
    haystack = new Map(rows.map((r) => [r, [r.ti, r.s, r.p, countries[r.c], types[r.t].label, r.k].join(" ").toLowerCase()]));
    for (const f of fields) $(f).addEventListener("input", () => {
      if (f === "year" || f === "month") setPeriod({ mode: "calendar", range: "all", year: $("year").value, month: $("month").value, date: "" });
      apply();
    });
    $("period").addEventListener("change", () => {
      setPeriod(changePeriod($("period").value, { year: $("year").value, month: $("month").value, date: day }, $("year").querySelectorAll("option")[1]?.value || ""));
      apply();
    });
    $("clear-day").addEventListener("click", () => { day = ""; period.date = ""; apply(); $("q").focus({ preventScroll: true }); });
    const loadMore = () => {
      if (renderedCount >= shown.length) return;
      limit = Math.min(shown.length, limit + PAGE);
      render(true);
    };
    $("more").addEventListener("click", loadMore);
    if (byYear && "IntersectionObserver" in window) {
      scrollObserver = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) loadMore();
      }, { rootMargin: "600px 0px" });
      window.addEventListener("pagehide", () => scrollObserver?.disconnect());
      window.addEventListener("pageshow", (event) => {
        if (event.persisted && renderedCount < shown.length) scrollObserver?.observe($("report-scroll-sentinel"));
      });
    }
    $("months").addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest("button");
      if (!b) return;
      const key = b.dataset.m!;
      const selection = timelineSelection(key, { year: $("year").value, month: $("month").value, date: day });
      if (!selection) return;
      if (selection.date) { selection.year = selection.date.slice(0, 4); selection.month = selection.date.slice(5, 7); }
      setPeriod({ mode: "calendar", range: "all", ...selection });
      apply();
      ($("months").querySelector<HTMLButtonElement>(`button[data-m="${key}"]`) || $("months").querySelector<HTMLButtonElement>("button"))?.focus({ preventScroll: true });
      hideTimelineTooltip();
    });
    document.querySelectorAll<HTMLButtonElement>("[data-range]").forEach((button) => button.addEventListener("click", () => {
      setPeriod(changePeriod(button.dataset.range!, { year: $("year").value, month: $("month").value, date: day }, $("year").querySelectorAll("option")[1]?.value || ""));
      apply();
      if (period.mode === "calendar") $("year").focus();
    }));
    const clearFilters = () => {
      for (const field of fields) $(field).value = "";
      setPeriod(changePeriod("all", {}));
      apply();
      $("q").focus({ preventScroll: true });
    };
    $("clear-filters").addEventListener("click", clearFilters);
    document.getElementById("clear-map-search")?.addEventListener("click", clearFilters);
    if (fields.some((f) => $(f).value) || day || period.mode === "calendar" || params.has("range") || range !== "all") apply();
    else { shown = rows; if (byYear) render(); months(); } // by year: the counts and months of all reports
  });
</script>

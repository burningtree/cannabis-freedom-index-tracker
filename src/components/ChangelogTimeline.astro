---
const { timeline, commitPages } = Astro.props;
const { buckets, interval } = timeline;
const kinds = ["added", "edited", "deleted", "renamed"];
const labels = { added: "Added", edited: "Edited", deleted: "Deleted", renamed: "Renamed" };
const total = (bucket) => kinds.reduce((sum, kind) => sum + bucket[kind], 0);
const max = Math.max(1, ...buckets.map(total));
const base = import.meta.env.BASE_URL;
const label = (date, hour = false) => new Date(date).toLocaleString("en-GB", { day: "numeric", month: "short", year: "numeric", ...(hour ? { hour: "2-digit", minute: "2-digit" } : {}), timeZone: "UTC" });
const description = (bucket) => `${label(bucket.date, true)} – ${label(bucket.end, true)} UTC: ${bucket.commits} commits; ${kinds.map((kind) => `${bucket[kind]} ${kind}`).join(", ")}`;
const link = (bucket) => {
  const page = commitPages[bucket.hash];
  return `${base}changelog/${page === 1 ? "" : `${page}/`}#commit-${bucket.hash}`;
};
---
{buckets.length > 0 && <section class="activity" aria-labelledby="activity-title">
  <div class="activity-header">
    <div><h2 id="activity-title">Report activity</h2><p>Changes per {interval} · commit times in UTC</p></div>
    <ul class="activity-legend" aria-label="Change types">
      {kinds.map((kind) => <li><span class={kind}></span>{labels[kind]}</li>)}
    </ul>
  </div>
  <div class="activity-chart">
    <div class="axis-label"><span>{max.toLocaleString("en-GB")}</span><span>0</span></div>
    <div class="plot">
      <div class="gridlines" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="bars">
        {buckets.map((bucket) => <a class:list={["bucket", { empty: total(bucket) === 0 }]} href={bucket.hash ? link(bucket) : undefined} tabindex={bucket.hash ? undefined : 0} title={description(bucket)} aria-label={description(bucket)}>
          <span class="bar-stack">
            {kinds.map((kind) => bucket[kind] > 0 && <span class={`segment ${kind}`} style={`height:${bucket[kind] / max * 100}%`}></span>)}
          </span>
        </a>)}
      </div>
    </div>
  </div>
  <div class="chart-dates"><span>{label(buckets[0].date)}</span><span>{label(buckets.at(-1).date)}</span></div>
  <p class="chart-help">Hover or focus a bar for counts. Select it to jump to that part of the history.</p>
</section>}

<style>
  .activity { --added: #78cba0; --edited: #e5bb65; --deleted: #ee939d; --renamed: #9cb5f5; padding: 18px 0 14px; margin: 0; border-block: 1px solid var(--border); }
  :global([data-theme="light"]) .activity { --added: #246d4b; --edited: #835c13; --deleted: #aa3548; --renamed: #465eb0; }
  .added { background: var(--added); }
  .edited { background: var(--edited); }
  .deleted { background: var(--deleted); }
  .renamed { background: var(--renamed); }
  .activity-header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: start; gap: 10px; margin-bottom: 16px; }
  .activity-header h2 { font: 400 20px/1.2 var(--display); margin: 0 0 4px; }
  .activity-header p, .chart-help { color: var(--text-2); font-size: 12px; margin: 0; }
  .activity-legend { display: flex; flex-wrap: wrap; gap: 8px 14px; list-style: none; margin: 4px 0 0; padding: 0; }
  .activity-legend li { display: flex; align-items: center; gap: 5px; font-size: 11px; color: var(--text-2); }
  .activity-legend li span { width: 7px; height: 7px; border-radius: 2px; }
  .activity-chart { display: flex; gap: 12px; }
  .axis-label { display: flex; flex-direction: column; justify-content: space-between; min-width: 30px; text-align: right; font: 10px var(--mono); color: var(--muted); }
  .plot { position: relative; flex: 1; min-width: 0; height: 88px; }
  .gridlines { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: space-between; pointer-events: none; }
  .gridlines i { border-top: 1px dashed var(--border); width: 100%; }
  .bars { position: relative; height: 100%; display: flex; align-items: stretch; gap: 3px; }
  .bucket { flex: 1; min-width: 0; display: block; height: 100%; border-radius: 2px 2px 0 0; }
  .bucket:hover, .bucket:focus-visible { background: var(--surface-2); outline: 1px solid var(--text-2); outline-offset: 2px; }
  .bar-stack { display: flex; flex-direction: column-reverse; height: 100%; justify-content: flex-start; }
  .segment { display: block; width: 100%; flex-shrink: 0; }
  .bucket.empty { padding: 0; }
  .empty .bar-stack::after { content: ""; height: 2px; background: var(--border); }
  .chart-dates { display: flex; justify-content: space-between; gap: 12px; margin: 10px 0 0 42px; font: 10px var(--mono); color: var(--muted); }
  .chart-help { margin-top: 10px; font-size: 11px; line-height: 1.5; }
  @media (max-width: 600px) { .bars { gap: 2px; } .plot { height: 76px; } }
</style>

---
// All reports as a list: search and filter by type, country, year and month, newest first.
import Base from "../../layouts/Base.astro";
import ReportBrowser from "../../components/ReportBrowser.astro";
import { reports, countriesWithReports, years } from "../../lib/reports.js";
import { TYPES, typeIcon } from "../../lib/types.js";

const usedTypes = Object.entries(TYPES).filter(([t]) => reports.some((r) => r.type === t || r.also?.includes(t)));
const fmt = (n) => n.toLocaleString("en-GB");
const base = import.meta.env.BASE_URL;
---
<Base title="Reports" description="Every report of cannabis eradication, seizures, raids, arrests, prosecutions and sentences, searchable and filterable." wide>
  <div class="reports-heading">
    <h1>Reports</h1>
    <a class="rss-button" href={`${base}feed.xml`} type="application/rss+xml" aria-label="Subscribe to reports via RSS">
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="4" cy="16" r="1.2" fill="currentColor" stroke="none"/><path d="M3 9a8 8 0 0 1 8 8M3 3a14 14 0 0 1 14 14"/></svg>
      RSS
    </a>
  </div>
  <p class="lead">
    {fmt(reports.length)} reports from {countriesWithReports().length} countries and states, newest first. Search them, filter by
    type, country and date, or <a href={`${base}${years[0] ?? ""}/`}>browse by month</a>.
  </p>
  <ul class="legend">
    {usedTypes.map(([id, v]) => <li class="type" title={v.help}><Fragment set:html={typeIcon(id, 16)} />{v.label}</li>)}
  </ul>
  <ReportBrowser />
</Base>


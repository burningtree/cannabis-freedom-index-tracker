---
import Base from "../layouts/Base.astro";
import { submissionsAPI as api } from "../lib/submissions-config.js";
import "../styles/submissions.css";

const npub = import.meta.env.PUBLIC_NOSTR_BOT_NPUB || "";
const relays = (import.meta.env.PUBLIC_NOSTR_RELAYS || "").split(",").filter(Boolean);
---
<Base title="Submit a source" description="Contribute a public news source to the Cannabis Enforcement Tracker and follow its processing.">
  <div class="submissions" data-submissions data-api={api} data-base={import.meta.env.BASE_URL}>
    <p class="eyebrow">Contribute to the record</p>
    <h1>Submit a source</h1>
    <p class="lead intro">Found reporting of a cannabis raid, seizure, arrest or court case? Send one news URL. Follow its progress with a receipt, without an account.</p>
    <form id="submission-form" class="panel">
      <p>No account required. Submitted URLs, public notes and outcomes may be permanently public on Nostr. This does not guarantee anonymity from your network or hosting provider.</p>
      <p class="hint">Use published reporting. Do not submit private identities, confidential documents, personal contact details or unpublished allegations.</p>
      <label for="source-url">News URL</label>
      <input id="source-url" name="url" type="url" placeholder="https://…" required maxlength="4096" autocomplete="url" disabled={!api} />
      <label for="public-note">Public note <span class="muted">(optional)</span></label>
      <textarea id="public-note" name="note" maxlength="500" rows="3" aria-describedby="note-hint" disabled={!api}></textarea>
      <p id="note-hint" class="hint">Up to 500 characters. This note is public.</p>
      <button type="submit" class="primary" disabled={!api}>Submit source</button>
      <div id="submit-message" class="notice" role="status" aria-live="polite">{!api && "Submissions are not available yet. Please check back."}</div>
    </form>
    <section aria-labelledby="my-submissions-title">
      <h2 id="my-submissions-title">My submissions</h2>
      <p><a href={`${import.meta.env.BASE_URL}submission/`} style="text-decoration:underline">Submission status →</a></p>
      <p class="hint">Receipts are saved in this browser. Export them to keep a copy or move to another browser. Removing a receipt here does not delete its public submission or Nostr events.</p>
      <div class="actions">
        <button id="export-receipts" type="button">Export receipts</button>
        <label class="file-button" for="import-receipts" style="margin:0">Import receipts</label>
        <input id="import-receipts" class="visually-hidden" type="file" accept="application/json,.json" />
        <button id="refresh-submissions" type="button" disabled={!api}>Refresh</button>
      </div>
      <p id="receipts-message" class="notice" role="status" aria-live="polite"></p>
      <div id="receipts-list"></div>
      <div class="actions"><button id="receipts-prev" type="button" hidden>Previous</button><button id="receipts-next" type="button" hidden>Next</button></div>
    </section>
    {npub && <section class="panel"><h2 style="margin-top:0">Submit from Nostr</h2><p>Mention <a href={`https://njump.me/${npub}`} class="ext">the tracker bot</a> with one news URL in a normal post. Include the bot as a tagged mention so it can receive your submission.</p><p class="hint" style="overflow-wrap:anywhere">{npub}</p><p>The bot replies in your thread when there is an outcome.</p>{relays.length > 0 && <><p class="hint">Publish to one of the bot’s read relays to help your mention reach it:</p><ul>{relays.map(relay => <li class="mono">{relay}</li>)}</ul></>}</section>}
    <noscript><p>JavaScript is needed to send sources and load receipt status.</p></noscript>
  </div>
  <script>import "../scripts/submissions.js";</script>
</Base>

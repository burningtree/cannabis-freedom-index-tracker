---
// The map: all reports on a full-screen map, with the filterable list in a pane on the right.
import Base from "../layouts/Base.astro";
import WorldMap from "../components/WorldMap.astro";
import ReportBrowser from "../components/ReportBrowser.astro";
import { reports, countriesWithReports, totals } from "../lib/reports.js";
import { TYPES, typeIcon } from "../lib/types.js";

const usedTypes = Object.entries(TYPES).filter(([t]) => reports.some((r) => r.type === t || r.also?.includes(t)));
const t = totals(reports);
const fmt = (n) => n.toLocaleString("en-GB");
const base = import.meta.env.BASE_URL;
---
<Base app>
  <div class="home">
    <div class="home-map"><WorldMap hash label="World map of enforcement reports" /></div>
    <aside class="home-pane" aria-label="Reports">
      <header class="pane-head">
        <h1>Cannabis Enforcement Tracker</h1>
        <p>Fields burned, homes raided, people arrested, jailed and executed: a sourced record of what
          cannabis prohibition does to people. {fmt(t.reports)} reports, {countriesWithReports().length} countries and states.</p>
        <ul class="legend">
          {usedTypes.map(([id, v]) => <li class="type" title={v.help}><Fragment set:html={typeIcon(id, 16)} />{v.label}</li>)}
        </ul>
      </header>
      <ReportBrowser compact />
      <footer class="pane-foot">
        A companion to the <a href="https://cannabisfreedom.fyi/" target="_blank" rel="noopener">Cannabis Freedom Index</a>.
        Every report cites its sources. Data: <a href={`${base}api/reports.json`}>JSON</a> · <a href={`${base}feed.xml`}>RSS</a>.
      </footer>
    </aside>
  </div>
</Base>

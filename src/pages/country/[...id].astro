---
// One page per CFI country, territory or state, including places with no reports yet.
import Base from "../../layouts/Base.astro";
import WorldMap from "../../components/WorldMap.astro";
import CfiWidget from "../../components/CfiWidget.astro";
import ReportBrowser from "../../components/ReportBrowser.astro";
import { reportsOf, totals, countByType } from "../../lib/reports.js";
import { countries, countryName, countryOf, flagOf } from "../../lib/countries.js";
import { TYPES, typeIcon } from "../../lib/types.js";
import { compact } from "../../lib/stats.js";
import { formatWeight } from "../../lib/figures.js";
import { cfiOf } from "../../lib/cfi.js";

export function getStaticPaths() {
  return countries.map((c) => ({ params: { id: c.id } }));
}
const { id } = Astro.params;
const c = countryOf(id);
const name = countryName(id);
const list = reportsOf(id);
const t = totals(list);
const byType = Object.entries(countByType(list)).filter(([, n]) => n);
const states = countries.filter((s) => s.parent === id);
const base = import.meta.env.BASE_URL;
const fmt = (n) => n.toLocaleString("en-GB");
// the figures the reports state, in short form (5.2M) with the exact number on hover
const figures = [
  ["People arrested", t.arrested], ["Plants destroyed", t.plants_destroyed], ["Hectares destroyed", t.hectares],
  ["Cannabis seized", t.kg_seized, formatWeight(t.kg_seized, 6), formatWeight(t.kg_seized)], ["Deaths", t.deaths],
].filter(([, v]) => v > 0);
const hasCfi = Boolean(cfiOf(id));
---
<Base title={`${name}: cannabis enforcement`} description={`${list.length} sourced reports of cannabis eradication, seizures, raids, arrests and sentences in ${name}.`} wide>
  <nav class="crumbs"><a href={`${base}country/`}>Countries</a>{c.parent && <> / <a href={`${base}country/${c.parent}/`}>{countryName(c.parent)}</a></>}</nav>
  <link slot="head" rel="alternate" type="application/rss+xml" href={`${base}feed/${id}.xml`} title={`${name}: new reports (RSS)`} />
  <div class="reports-heading">
    <h1>{flagOf(id)} {name}</h1>
    <a class="rss-button" href={`${base}feed/${id}.xml`} type="application/rss+xml" aria-label={`Follow new reports in ${name} via RSS`} title={`New reports in ${name}, as an RSS feed`}>
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="4" cy="16" r="1.2" fill="currentColor" stroke="none"/><path d="M3 9a8 8 0 0 1 8 8M3 3a14 14 0 0 1 14 14"/></svg>
      RSS
    </a>
  </div>
  <p class="lead">{list.length ? `${list.length} ${list.length === 1 ? "report" : "reports"} of cannabis enforcement.` : "No enforcement reports recorded here yet."}</p>

  {figures.length > 0 && (
    <>
      <dl class="country-figures" style={`--n:${figures.length}`}>
        {figures.map(([label, v, weight, exactWeight]) => <div><dt>{label}</dt><dd title={exactWeight ?? v.toLocaleString("en-GB")}>{weight ?? compact(v)}</dd></div>)}
      </dl>
      <p class="note">Only what the reports state; most operations are never reported in numbers.</p>
    </>
  )}

  <div class:list={["country-top", { "no-cfi": !hasCfi }]}>
    <div class="country-map">
      <WorldMap country={id} label={`Map of reports in ${name}`} />
      <ul class="legend">{byType.map(([tid, n]) => <li class="type"><Fragment set:html={typeIcon(tid, 16)} />{TYPES[tid].label} · {n}</li>)}</ul>
    </div>
    {hasCfi && <div class="country-side"><CfiWidget id={id} /></div>}
  </div>

  {states.length > 0 && (
    <>
      <h2>States and provinces</h2>
      <ul class="cards">{states.map((s) => <li><a href={`${base}country/${s.id}/`}>{s.name} <span class="muted">· {reportsOf(s.id).length}</span></a></li>)}</ul>
    </>
  )}

  <h2 id="reports">Reports</h2>
  <ReportBrowser country={id} />
  <p class="note">This country's reports as data: <a href={`${base}api/country/${id}.json`}>{`/api/country/${id}.json`}</a></p>
</Base>

<style>
  .country-top { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(300px, 1fr); gap: 24px; align-items: stretch; margin: 20px 0 8px; }
  /* the map fills its column down to the bottom of the figures and the CFI beside it */
  .country-map { display: flex; flex-direction: column; min-width: 0; }
  .country-map :global(.map) { flex: 1; height: auto; min-height: clamp(320px, 52vw, 480px); }
  .country-top.no-cfi { grid-template-columns: 1fr; }
  .country-top.no-cfi .country-map :global(.map) { flex: none; height: clamp(320px, 45vw, 520px); }
  .country-side :global(.cfi) { margin: 0; }
  .country-side :global(.cfi-segs li) { grid-template-columns: minmax(0, 1fr) 1fr 22px; }
  .country-figures { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 1px; margin: 20px 0 0; background: var(--border); border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; }
  .country-figures div { padding: 16px 18px; background: var(--surface); min-width: 0; }
  @media (max-width: 700px) { .country-figures { grid-template-columns: repeat(2, minmax(0, 1fr)); } .country-figures div:last-child:nth-child(odd) { grid-column: 1 / -1; } }
  .country-figures dt { font: 11px var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .country-figures dd { margin: 6px 0 0; font: 400 clamp(28px, 3.4vw, 40px)/1.05 var(--display); }
  .country-figures + .note { margin: 8px 0 0; }
  @media (max-width: 860px) { .country-top, .country-top.no-cfi { grid-template-columns: 1fr; } .country-map :global(.map) { flex: none; height: clamp(300px, 70vw, 440px); } }
</style>

---
import "../styles/global.css";
import { reports } from "../lib/reports.js";
import { submissionsAPI as api } from "../lib/submissions-config.js";
const { title, description = "An open record of cannabis eradication, seizures, raids, arrests, prosecutions and sentences around the world.", wide = false, app = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = title ? `${title} · Cannabis Enforcement Tracker` : "Cannabis Enforcement Tracker";
const canonical = new URL(Astro.url.pathname, Astro.site);
const here = Astro.url.pathname.replace(base, "/");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#0c0c0b" />
    <script is:inline>
      // the theme before the page is drawn: the reader's choice, else the system's
      (() => {
        let t = null;
        try { t = localStorage.getItem("theme"); } catch {}
        t ||= matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.dataset.theme = t;
        if (t === "light") document.querySelector('meta[name="theme-color"]').setAttribute("content", "#f4f2eb");
      })();
    </script>
    <link rel="alternate" type="application/rss+xml" href={`${base}feed.xml`} title="New reports (RSS)" />
    <link rel="alternate" type="application/json" href={`${base}api/reports.json`} title="All reports (JSON)" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class:list={{ "app-body": app }}>
    <header class="topbar">
      <a class="brand" href={base}><span class="brand-mark" aria-hidden="true">✕</span><span><span class="brand-first">Cannabis </span>Enforcement Tracker</span></a>
      <span class="brand-by">by</span>
      <a class="cfi-link" href="https://cannabisfreedom.fyi/" target="_blank" rel="noopener" title="The companion site: what each country's cannabis laws allow">
        <!-- the Cannabis Freedom Index's own mark, its favicon (public/favicon.svg there), in the text colour -->
        <svg class="cfi-link-icon" viewBox="0 0 32 32" aria-hidden="true"><g transform="translate(16 26.4) scale(2.12)"><path d="M0 0C1.9-2.6 1.5-7 0-10C-1.5-7-1.9-2.6 0 0Z"/><path d="M0 0C1.9-2.6 1.5-7 0-10C-1.5-7-1.9-2.6 0 0Z" transform="rotate(-31) scale(0.9)"/><path d="M0 0C1.9-2.6 1.5-7 0-10C-1.5-7-1.9-2.6 0 0Z" transform="rotate(31) scale(0.9)"/><path d="M0 0C1.9-2.6 1.5-7 0-10C-1.5-7-1.9-2.6 0 0Z" transform="rotate(-63) scale(0.7)"/><path d="M0 0C1.9-2.6 1.5-7 0-10C-1.5-7-1.9-2.6 0 0Z" transform="rotate(63) scale(0.7)"/><path d="M0 0C1.9-2.6 1.5-7 0-10C-1.5-7-1.9-2.6 0 0Z" transform="rotate(-97) scale(0.43)"/><path d="M0 0C1.9-2.6 1.5-7 0-10C-1.5-7-1.9-2.6 0 0Z" transform="rotate(97) scale(0.43)"/></g></svg>
        <span class="cfi-link-long">Cannabis Freedom Index</span><span class="cfi-link-short">CFI</span> ↗
      </a>
      <span class="svc-counters">
      <a class="svc-total" href={`${base}reports/`} title={`${reports.length.toLocaleString("en-GB")} committed reports`} aria-label={`${reports.length.toLocaleString("en-GB")} committed reports`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8zM14 3v5h5M8 14l2.5 2.5L16 11"/></svg>
        <span>{reports.length.toLocaleString("en-GB")}</span>
      </a>
      {/* the submissions service: a dot for whether it answers, and how many requests it is working on */}
      {api && <a class="svc-status" id="svc-status" href={`${base}submissions/`} data-api={api} data-state="checking" title="Checking the submissions service…" aria-label="Submissions service: checking"><svg class="svc-cog" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="6.5"/><circle cx="12" cy="12" r="2.2"/><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1"/></svg><span class="svc-count" hidden></span><span class="svc-queue" hidden><svg class="svc-queue-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12M6 21h12M7.5 3v3.5L12 12l-4.5 5.5V21M16.5 3v3.5L12 12l4.5 5.5V21"/></svg><span class="svc-queue-count"></span></span></a>}
      </span>
      <nav class="nav">
        <a href={base} aria-current={here === "/" ? "page" : undefined}>Map</a>
        <a href={`${base}reports/`} aria-current={here.startsWith("/report") || /^\/\d{4}\//.test(here) ? "page" : undefined}>Reports</a>
        <a href={`${base}country/`} aria-current={here.startsWith("/country") ? "page" : undefined}>Countries</a>
        <a href={`${base}stats/`} aria-current={here.startsWith("/stats") ? "page" : undefined}>Statistics</a>
        <a href={`${base}submissions/`} aria-current={here.startsWith("/submi") ? "page" : undefined}>Submit</a>
        <a href={`${base}about/`} aria-current={here.startsWith("/about") ? "page" : undefined}>About</a>
      </nav>
      <a class="github-link" href="https://github.com/burningtree/cannabis-freedom-index-tracker" target="_blank" rel="noopener" aria-label="View source on GitHub" title="View source on GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .75a11.25 11.25 0 0 0-3.558 21.924c.563.103.768-.244.768-.542 0-.267-.01-.975-.015-1.914-3.13.68-3.79-1.508-3.79-1.508-.512-1.3-1.25-1.646-1.25-1.646-1.022-.7.078-.686.078-.686 1.13.08 1.725 1.16 1.725 1.16 1.004 1.72 2.633 1.223 3.274.935.102-.727.393-1.223.714-1.504-2.5-.284-5.128-1.25-5.128-5.565 0-1.23.44-2.233 1.16-3.02-.117-.284-.503-1.43.11-2.98 0 0 .945-.302 3.094 1.154A10.78 10.78 0 0 1 12 6.18c.956.005 1.918.13 2.818.379 2.147-1.456 3.09-1.154 3.09-1.154.615 1.55.229 2.696.113 2.98.722.787 1.158 1.79 1.158 3.02 0 4.326-2.632 5.278-5.14 5.557.404.35.765 1.043.765 2.1 0 1.515-.014 2.737-.014 3.11 0 .3.203.65.774.54A11.252 11.252 0 0 0 12 .75Z"/></svg>
      </a>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch between dark and light">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </header>
    {api && <script>
      // The header's service dot. It holds the same WebSocket as the submissions list
      // (/v1/submissions/stream): while it is open the service is online, and each change it announces
      // re-reads the counts from /v1/status. Without a socket it falls back to asking every 20 seconds.
      const box = document.getElementById("svc-status");
      if (box) {
        const api = (box.dataset.api || "").replace(/\/$/, "");
        const count = box.querySelector<HTMLElement>(".svc-count")!;
        const queue = box.querySelector<HTMLElement>(".svc-queue")!, queueCount = box.querySelector<HTMLElement>(".svc-queue-count")!;
        // the cog turns while requests are worked on, with their number; the queue's length beside it
        const show = (state: string, title: string, n = 0, queued = 0) => {
          box.dataset.state = state; box.title = title; box.setAttribute("aria-label", `Submissions service: ${title}`);
          count.hidden = n < 1; count.textContent = String(n);
          queue.hidden = queued < 1; queueCount.textContent = String(queued);
        };
        const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
        let socket: WebSocket | null = null, live = false, failures = 0, retry = 0, poll = 0, pending = 0;
        const counts = async () => {
          try {
            const r = await fetch(`${api}/v1/status`, { credentials: "omit", cache: "no-store" });
            if (r.status === 404) { show("online", "Online (this backend is older and gives no counts; restart it)"); return; }
            if (!r.ok) throw new Error(String(r.status));
            const v = await r.json();
            const waiting = v.queued ? `, ${v.queued} queued` : "";
            if (!v.processing) show("paused", `Online, AI processing is off${v.reason ? `: ${v.reason}` : ""}${waiting}`, v.running, v.queued);
            else if (v.running) show("working", `Online, working on ${plural(v.running, "request")}${waiting}`, v.running, v.queued);
            else show("online", `Online, idle${waiting}`, 0, v.queued);
          } catch { if (!live) show("offline", "Offline: the submissions service does not answer"); }
        };
        const soon = () => { clearTimeout(pending); pending = window.setTimeout(counts, 300); };
        // every 20 seconds as long as the tab is visible: the counts, even if the socket says nothing
        const tick = () => { clearTimeout(poll); if (document.hidden) return; counts(); poll = window.setTimeout(tick, 20000); };
        const connect = () => {
          if (socket || document.hidden || !window.WebSocket) return;
          try {
            const url = new URL(`${api}/v1/submissions/stream`, location.href); url.protocol = url.protocol === "https:" ? "wss:" : "ws:";
            const current = new WebSocket(url); socket = current;
            current.onmessage = (e) => {
              try { if (JSON.parse(e.data).type === "submissions_changed") { live = true; failures = 0; soon(); } } catch { /* unknown message */ }
            };
            current.onclose = () => {
              if (socket !== current) return;
              socket = null; live = false; counts();
              if (!document.hidden) { clearTimeout(retry); retry = window.setTimeout(connect, Math.min(30000, 1000 * 2 ** Math.min(failures++, 5))); }
            };
          } catch { socket = null; }
        };
        document.addEventListener("visibilitychange", () => {
          if (document.hidden) { socket?.close(); socket = null; live = false; clearTimeout(poll); clearTimeout(retry); }
          else { connect(); tick(); }
        });
        connect(); tick();
      }
    </script>}
    <main class:list={[app ? "app" : "page", { wide }]}>
      <slot />
    </main>
    {!app && (
    <footer class="footer">
        <p>
          A companion to the <a href="https://cannabisfreedom.fyi/" class="ext" target="_blank" rel="noopener">Cannabis Freedom Index</a>.
          Every report cites its sources. Data: <a href={`${base}api/reports.json`}>JSON</a> · <a href={`${base}feed.xml`}>RSS</a> · <a href={`${base}changelog/`}>Changelog</a>.
        </p>
      </footer>
    )}
    <script>import "../scripts/glossary.js";</script>
    <script>
      // the theme switch; the map listens for "theme:change" to swap its basemap
      const root = document.documentElement;
      const set = (t: string, save: boolean) => {
        root.dataset.theme = t;
        if (save) { try { localStorage.setItem("theme", t); } catch {} }
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", t === "light" ? "#f4f2eb" : "#0c0c0b");
        document.dispatchEvent(new CustomEvent("theme:change", { detail: t }));
      };
      document.getElementById("theme-toggle")!.addEventListener("click", () => set(root.dataset.theme === "light" ? "dark" : "light", true));
      // follow the system while the reader has not chosen
      matchMedia("(prefers-color-scheme: light)").addEventListener("change", (e) => {
        let saved = null;
        try { saved = localStorage.getItem("theme"); } catch {}
        if (!saved) set(e.matches ? "light" : "dark", false);
      });
    </script>
  </body>
</html>
